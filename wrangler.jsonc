{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cherion-site1",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cherion-db",
      "database_id": "5eb73195-5257-4234-be41-aba7ca512308"
    }
  ]
}
